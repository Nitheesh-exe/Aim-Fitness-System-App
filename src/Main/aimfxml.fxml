                              <Button onAction="#confirmDeleteAction" prefHeight="40.0" prefWidth="108.0" style="-fx-background-color: #D13438; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Yes, Delete" />
                              <Button onAction="#closeDeletePopup" prefHeight="40.0" prefWidth="108.0" style="-fx-font-weight: bold;" styleClass="btn-secondary" text="Cancel" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
