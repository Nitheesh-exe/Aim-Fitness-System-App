<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane style="-fx-font-family: 'Segoe UI', Arial, sans-serif;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Login.LoginController">
   <children>
      <!-- Background Image (Stretches across the whole window) -->
      <ImageView pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <image>
            <Image url="@gym.png" />
         </image>
      </ImageView>

      <!-- STRICT 50/50 GRID PANE -->
      <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
         
            <!-- Left Column: Branding layered with StackPane -->
            <StackPane GridPane.columnIndex="0">
               <children>
                  <!-- Semi-transparent overlay (Now confined ONLY to the left 50% cell) -->
                  <Pane opacity="0.80" style="-fx-background-color: white;" />
                  
                  <!-- Left Column Content -->
                  <VBox alignment="CENTER">
                     <children>
                        <VBox alignment="CENTER_LEFT" maxWidth="380.0">
                           <children>
                              <VBox spacing="-8.0">
                                 <children>
                                    <Label style="-fx-text-fill: #FF7A00; -fx-font-size: 46px; -fx-font-weight: 900;" text="Stronger" />
                                    <Label style="-fx-text-fill: #111111; -fx-font-size: 46px; -fx-font-weight: 900;" text="Today" />
                                    <Label style="-fx-text-fill: #FF7A00; -fx-font-size: 46px; -fx-font-weight: 900;" text="Better" />
                                    <Label style="-fx-text-fill: #111111; -fx-font-size: 46px; -fx-font-weight: 900;" text="Tomorrow" />
                                 </children>
                              </VBox>

                              <Region prefHeight="5.0" prefWidth="70.0" style="-fx-background-color: #FF7A00; -fx-pref-width: 70px; -fx-max-width: 70px; -fx-pref-height: 5px; -fx-background-radius: 3px;">
                                 <VBox.margin>
                                    <Insets bottom="10.0" top="8.0" />
                                 </VBox.margin>
                              </Region>

                              <Label style="-fx-text-fill: #333333; -fx-font-size: 14px; -fx-font-weight: 600;" text="Push your limits, stay consistent,&#10;and achieve the body you deserve." />

                              <HBox spacing="15.0">
                                 <children>
                                    <VBox alignment="CENTER" spacing="4.0">
                                       <children>
                                          <SVGPath content="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z" scaleX="1.1" scaleY="1.1" />
                                          <Label style="-fx-text-fill: #FF7A00; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;" text="Hygiene" />
                                          <Label style="-fx-text-fill: #111111; -fx-font-size: 10px;" text="Well Cleaned" />
                                       </children>
                                    </VBox>

                                    <VBox alignment="CENTER" spacing="4.0">
                                       <children>
                                          <SVGPath content="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29l-1.43-1.43z" fill="#111111" scaleX="1.1" scaleY="1.1" />
                                          <Label style="-fx-text-fill: #FF7A00; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;" text="Equipment" />
                                          <Label style="-fx-text-fill: #111111; -fx-font-size: 10px;" text="Premium Quality" />
                                       </children>
                                    </VBox>

                                    <VBox alignment="CENTER" spacing="4.0">
                                       <children>
                                          <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" fill="#111111" scaleX="1.1" scaleY="1.1" />
                                          <Label style="-fx-text-fill: #FF7A00; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;" text="Management" />
                                          <Label style="-fx-text-fill: #111111; -fx-font-size: 10px;" text="Well Organized" />
                                       </children>
                                    </VBox>
                                 </children>
                                 <VBox.margin>
                                    <Insets top="15.0" />
                                 </VBox.margin>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <!-- Right Column: Interactive Login Card -->
            <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
               <children>
                  <VBox alignment="CENTER" maxWidth="350.0" spacing="15.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 25px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0, 0, 6);">
                     <children>
                        
                        <ImageView fitHeight="100.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@icon.png" />
                           </image>
                        </ImageView>

                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Label style="-fx-text-fill: #111111; -fx-font-size: 22px; -fx-font-weight: 900;" text="Welcome" />
                              <Label style="-fx-text-fill: #FF7A00; -fx-font-size: 22px; -fx-font-weight: 900;" text="Admin !" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" top="-5.0" />
                           </VBox.margin>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #E0E0E0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 0 15 0 15; -fx-pref-height: 42px;">
                           <children>
                              <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#111111" scaleX="1.0" scaleY="1.0">
                                 <HBox.margin>
                                    <Insets right="10.0" />
                                 </HBox.margin>
                              </SVGPath>
                              <TextField fx:id="usernameField" promptText="Admin Username" style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-prompt-text-fill: #A0A0A0; -fx-text-fill: #111111;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-color: #E0E0E0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 0 15 0 15; -fx-pref-height: 42px;">
                           <children>
                              <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" fill="#111111" scaleX="1.0" scaleY="1.0">
                                 <HBox.margin>
                                    <Insets right="10.0" />
                                 </HBox.margin>
                              </SVGPath>
                              <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-prompt-text-fill: #A0A0A0; -fx-text-fill: #111111;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #dc3545; -fx-font-size: 12px; -fx-font-weight: bold;" text="Incorrect username or password." visible="false">
                           <VBox.margin>
                              <Insets bottom="-5.0" top="-5.0" />
                           </VBox.margin>
                        </Label>

                        <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: #FF7A00; -fx-background-radius: 12px; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-height: 42px; -fx-cursor: hand;" text="Login">
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </Button>

                        <HBox alignment="CENTER" spacing="30.0">
                           <children>
                              <Label style="-fx-text-fill: #111111; -fx-font-size: 11px; -fx-underline: true; -fx-cursor: hand;" text="Forgot Password?" />
                              <Label style="-fx-text-fill: #111111; -fx-font-size: 11px;" text="Admin Access Only" />
                           </children>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </HBox>

                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </GridPane>
      <Button onAction="#closeApplication" style="-fx-background-color: rgba(0, 0, 0, 0.1); -fx-text-fill: #111111; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 15px; -fx-cursor: hand;" text="✕" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />

   </children>
</AnchorPane>
